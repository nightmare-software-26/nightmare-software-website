---
import Capabilities from "./Capabilities.astro";
---

<div>
	<section class="border-b border-line">
		<div class="mx-auto max-w-7xl px-5 py-20 sm:px-8 sm:py-28 lg:px-12">
			<p class="eyebrow">What we do</p>
			<h1
				class="mt-6 max-w-4xl text-5xl font-semibold leading-[.96] tracking-[-.065em] sm:text-7xl"
			>
				Infrastructure for your next move.
			</h1>
			<p class="mt-8 max-w-2xl text-lg leading-8 text-muted sm:text-xl">
				From first architecture decisions to the systems your team relies on
				every day, we make technology more capable and less fragile.
			</p>
		</div>
	</section>
	<Capabilities />
</div>
