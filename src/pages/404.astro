---
import Layout from "../layouts/Layout.astro";
---

<Layout>
	<section class="mx-auto max-w-3xl px-5 py-24 text-center">
		<h1 class="text-3xl font-semibold tracking-tight sm:text-4xl">
			404 - Not Found
		</h1>
		<p class="mx-auto mt-4 max-w-xl leading-7 opacity-70">
			Uh Oh. Looks like you are off track.
		</p>
		<div class="flex justify-center items-center gap-4 mt-8">
			<button type="button" class="button-light" onclick="history.back()">
				Go back
			</button>
			<a href="/" class="button-primary">Home page</a>
		</div>
	</section>
</Layout>
